{
  "name": "jerryqiu-sites",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for jerryqiu.com, photos., music. and flying. plus the @placeholder/ui package",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -n db,web,docs,photos -c green,cyan,magenta,yellow \"pnpm dev:db\" \"pnpm dev:web\" \"pnpm dev:docs\" \"pnpm dev:photos\"",
    "dev:web": "pnpm --filter @jerryqiu/web dev",
    "dev:photos": "pnpm --filter @jerryqiu/photos dev",
    "dev:docs": "pnpm --filter @jerryqiu/docs dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:e2e": "NEXT_PUBLIC_HUB_URL=http://localhost:4000 NEXT_PUBLIC_PHOTOS_URL=http://localhost:4002 NEXT_PUBLIC_MUSIC_URL=http://localhost:4000/music NEXT_PUBLIC_FLYING_URL=http://localhost:4000/flying pnpm build && playwright test",
    "dev:db": "pnpm --filter @jerryqiu/db dev",
    "db:migrate": "pnpm --filter @jerryqiu/db migrate",
    "db:seed": "pnpm --filter @jerryqiu/db seed",
    "db:generate": "pnpm --filter @jerryqiu/db generate",
    "test:admin": "playwright test -c playwright.admin.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^3.0.3",
    "@next/env": "16.3.8",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "chrome-launcher": "^1.2.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
