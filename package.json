{
  "name": "jerryqiu-sites",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for jerryqiu.com, photos., music. and flying. plus the @placeholder/ui package",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -n web,docs,photos -c cyan,magenta,yellow \"pnpm dev:web\" \"pnpm dev:docs\" \"pnpm dev:photos\"",
    "dev:web": "pnpm --filter @jerryqiu/web dev",
    "dev:photos": "pnpm --filter @jerryqiu/photos dev",
    "dev:docs": "pnpm --filter @jerryqiu/docs dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.64.0",
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3"
  }
}
