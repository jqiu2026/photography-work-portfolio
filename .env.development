# Local development defaults (no secrets: safe to commit). Override in .env.local. Ignored by production builds.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
DASHBOARD_OPEN_SIGNIN=true
AUTH_SECRET=dev-only-secret-never-use-in-production
ADMIN_EMAILS=local-dev@localhost
STORAGE_DRIVER=local
PAGE_ACCESS_PASSWORD=password
