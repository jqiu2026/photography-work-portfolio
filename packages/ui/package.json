{
  "name": "@halation/ui",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./motion": "./src/motion/index.ts",
    "./media": "./src/media/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens": "./src/tokens.ts",
    "./webgl": "./src/webgl/index.ts",
    "./stage": "./src/stage/index.ts",
    "./v3": "./src/v3/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@jerryqiu/config": "workspace:*",
    "@types/react": "^19.2.0",
    "react": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "ogl": "^1.0.11",
    "radix-ui": "^1.7.0",
    "simple-icons": "^16.34.0"
  },
  "sideEffects": ["**/*.css"],
  "description": "Halation UI: an immersive, scroll-driven design system. A persistent WebGL stage (fluid, light streaks, halation) with quality tiers and static fallbacks, one motion language (Flow), a floating index instead of a navbar, and accessible primitives. Licence undecided (Q32).",
  "keywords": [
    "react",
    "design-system",
    "immersive",
    "webgl",
    "scroll",
    "motion",
    "fluid",
    "accessibility",
    "photography",
    "portfolio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TODO-owner/TODO-repo.git",
    "directory": "packages/ui"
  },
  "homepage": "https://TODO-owner.example/docs",
  "bugs": {
    "url": "https://github.com/TODO-owner/TODO-repo/issues"
  },
  "author": "TODO(owner): copyright holder",
  "files": ["LICENSE", "README.md", "dist", "licenses"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./motion": {
        "types": "./dist/motion/index.d.ts",
        "import": "./dist/motion/index.js"
      },
      "./media": {
        "types": "./dist/media/index.d.ts",
        "import": "./dist/media/index.js"
      },
      "./webgl": {
        "types": "./dist/webgl/index.d.ts",
        "import": "./dist/webgl/index.js"
      },
      "./tokens": {
        "types": "./dist/tokens.d.ts",
        "import": "./dist/tokens.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  }
}
