# Copy to .env.local. Nothing here is required to run the site locally.

# Shared password for pages with `protected: true` in their frontmatter (see /api/authenticate)
PAGE_ACCESS_PASSWORD=password

# Sibling site URLs (defaults: localhost in dev, real subdomains in production)
# NEXT_PUBLIC_HUB_URL=http://localhost:3000
# NEXT_PUBLIC_PHOTOS_URL=http://localhost:3002
# NEXT_PUBLIC_MUSIC_URL=http://localhost:3003
# NEXT_PUBLIC_FLYING_URL=http://localhost:3004
