{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "**/.next",
      "**/.next-e2e*",
      "**/dist",
      "**/node_modules",
      "DRAFTS",
      "docs",
      "**/public/opt",
      "**/private/opt",
      "**/public/sequence",
      "pnpm-lock.yaml",
      "**/*.mdx",
      "**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "organizeImports": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useSingleVarDeclarator": "off",
        "useTemplate": "off",
        "useNumberNamespace": "off",
        "noUselessElse": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off",
        "useFocusableInteractive": "off",
        "noNoninteractiveTabindex": "off",
        "useAltText": "off",
        "useMediaCaption": "off",
        "useValidAnchor": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "include": ["packages/ui/src/v3/**"],
      "linter": {
        "rules": {
          "style": {
            "noCommaOperator": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          },
          "a11y": {
            "useKeyWithClickEvents": "off",
            "useValidAriaValues": "off"
          }
        }
      }
    }
  ]
}
