# Copy to .env.local (never commit it). Local development works with NO values set: `pnpm dev` starts a local
# database (PGlite) and local file storage, and DASHBOARD_OPEN_SIGNIN gives you the admin without Google.
# Missing production credentials never crash the app: features degrade and say what to set.

# --- Database (Neon free tier in production; the Vercel integration sets this for you) ---
# Local default (see .env.development): postgres://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_URL=

# --- Auth (Auth.js v5 + Google, @jerryqiu.com only). Setup: docs/google-oauth-setup.md ---
AUTH_SECRET=                      # openssl rand -base64 32. REQUIRED in production. Same value in every app.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=jerryqiu.com # Workspace domain; verified from the ID token `hd` claim AND the email suffix
ADMIN_EMAILS=                     # comma separated; created as owners on first sign-in / seed
AUTH_COOKIE_DOMAIN=               # production only: .jerryqiu.com (one staff sign-in across subdomains)

# --- Local-only escape hatch (ignored by production builds) ---
DASHBOARD_OPEN_SIGNIN=            # true = open the admin as a local owner without Google (NODE_ENV=development only)

# --- Storage: STORAGE_DRIVER = local | r2 | blob ("blob" only for the public store) ---
STORAGE_DRIVER=local
STORAGE_DIR=                      # default ~/.jerryqiu-dev/storage (outside the repo on purpose)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=              # private
R2_BUCKET_PUBLIC=                 # derivatives
BLOB_READ_WRITE_TOKEN=

# --- Image protection ---
IMAGE_TOKEN_SECRET=               # defaults to AUTH_SECRET
IMAGE_TOKEN_SECRET_PREVIOUS=      # previous key while rotating

# --- Email (Resend free tier) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@jerryqiu.com
CONTACT_FROM_EMAIL=            # a sender verified in Resend, e.g. site@jerryqiu.com
# Photo site email (TODO(owner): needs RESEND_API_KEY and EMAIL_FROM). Without them development uses a labelled MOCK outbox
# and production records `skipped` in the studio inbox.
EMAIL_FROM=                       # e.g. "Jerry Qiu Photography <studio@mail.jerryqiu.com>" (a sender verified in Resend)
EMAIL_REPLY_TO=                   # a real inbox that receives client replies
TURNSTILE_SECRET_KEY=             # optional, free spam check
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Cron (Vercel Cron sends this as a bearer token) ---
# PORTAL_PASSCODE_LIMIT=8          # gallery passcode tries per address per 10 minutes (tests raise it)
CRON_SECRET=                      # 16+ random characters; the purge route refuses to run without it

# --- Cross-site cache refresh (same value in the hub and photos projects, 16+ random characters) ---
REVALIDATE_SECRET=

# --- Site URLs (defaults: localhost in dev, real subdomains in production) ---
NEXT_PUBLIC_HUB_URL=
NEXT_PUBLIC_PHOTOS_URL=
NEXT_PUBLIC_MUSIC_URL=
NEXT_PUBLIC_FLYING_URL=

# --- Protected project pages (shared password for `protected` projects) ---
PAGE_ACCESS_PASSWORD=

# --- Embedding the inquiry form (/embed/inquiry): extra origins allowed to frame it, space or comma separated ---
EMBED_ALLOWED_ORIGINS=
# TODO(owner): needs STRIPE_PRICE_FULLFRAME (a Stripe Price id for the monthly Full Frame plan; with the Stripe keys it enables paid upgrades)
STRIPE_PRICE_FULLFRAME=

# --- Music site (apps/music): sender for its emails (receipts, sign-in links, newsletter); falls back to EMAIL_FROM ---
MUSIC_EMAIL_FROM=                 # e.g. "Jerry Qiu Music <music@mail.jerryqiu.com>" (a sender verified in Resend)
# Score payments use STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET with a SEPARATE webhook endpoint on the music project:
# https://music.jerryqiu.com/api/webhooks/stripe (events: checkout.session.completed, charge.refunded).
# Score files use STORAGE_DRIVER and BLOB_READ_WRITE_TOKEN (private/ prefix); the music project needs its own Blob store.

# --- Make and Flying ---
NEXT_PUBLIC_MAKE_URL=             # default https://make.jerryqiu.com; also set on the hub so sign-in accepts it
FLYING_WEATHER=                   # live = use NOAA's Aviation Weather Center in development; off = no lookup; empty = live in production, SAMPLE in development
FLYING_INSTRUCTION=               # on = show the hidden /instruction page (a local demo; production uses the studio setting)
